{
  "name": "video-sniffer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "嗅探网页中的视频资源（mp4 / HLS / FLV 等），支持 m3u8 分片下载并合并为 MP4",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "check": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "mux.js": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
